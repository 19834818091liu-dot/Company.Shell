<UserControl
    x:Class="Company.Application.Run.Views.RunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Company.Application.Run.Views"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:vm="clr-namespace:Company.Application.Run.ViewModels"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:coreEnums="clr-namespace:Company.Core.Enums;assembly=Company.Core"
    xmlns:contorls="clr-namespace:Company.Application.UI.Controls;assembly=Company.Application.UI"
    xmlns:cameraEnums="clr-namespace:Company.Hardware.Camera.Base;assembly=Company.Hardware.Camera.Base"
    d:DataContext="{d:DesignInstance vm:RunViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="900"
    d:DesignWidth="1500"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--  left  -->
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Border Height="35" Background="#F5F5F5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Margin="10,0,0,0" VerticalAlignment="Center" Kind="RegularPalette" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="轨道类型" />
                    </StackPanel>
                </Border>
                <WrapPanel>
                    <RadioButton
                        Height="45"
                        Margin="25,8,8,8"
                        IsChecked="{Binding RunManager.Is8mm, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <!--  checked触发条件：ischecked从false变为true，ischecked管状态，checked管动作  -->
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.TapeWidthChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                    <RadioButton
                        Height="45"
                        Margin="8,8,8,8"
                        IsChecked="{Binding RunManager.Is12mm, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.TapeWidthChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                    <RadioButton
                        Height="45"
                        Margin="8,8,8,8"
                        IsChecked="{Binding RunManager.Is16mm, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.TapeWidthChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                    <RadioButton
                        Height="45"
                        Margin="8,8,8,8"
                        IsChecked="{Binding RunManager.Is24mm, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.TapeWidthChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                </WrapPanel>
                <Border Height="35" Background="#F5F5F5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Margin="10,0,0,0" VerticalAlignment="Center" Kind="RegularPalette" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="运行模式" />
                    </StackPanel>
                </Border>
                <WrapPanel>
                    <RadioButton
                        Height="45"
                        Margin="25,8,8,8"
                        IsChecked="{Binding RunManager.IsNormalLink, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.RunModeChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                    <RadioButton
                        Height="45"
                        Margin="8,8,8,8"
                        Style="{StaticResource RadioButton.TapeWidth.Style}"
                        IsChecked="{Binding RunManager.IsMeasureLink, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.RunModeChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>

                    <RadioButton
                        Height="45"
                        Margin="8,8,8,8"
                        IsChecked="{Binding RunManager.IsMeasure, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.RunModeChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                    <RadioButton
                        Height="45"
                        Margin="8,8,8,8"
                        IsChecked="{Binding RunManager.IsSilk, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource RadioButton.TapeWidth.Style}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding RunManager.RunModeChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                </WrapPanel>
                <Border Height="35" Background="#F5F5F5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Margin="10,0,0,0" VerticalAlignment="Center" Kind="RegularPalette" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="其他参数" />
                    </StackPanel>
                </Border>
                <WrapPanel>
                    <Rectangle Width="25" />
                    <mah:ToggleSwitch
                        Header="是否检空"
                        OnContent="开"
                        OffContent="关"
                        FontSize="16"
                        IsOn="{Binding RunManager.TaskParameter.IsCheckEmpty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <mah:ToggleSwitch
                        Header="是否加热"
                        OnContent="开"
                        OffContent="关"
                        FontSize="16"
                        IsOn="{Binding RunManager.TaskParameter.IsHeat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </WrapPanel>
                <StackPanel Margin="25,10,25,0" Orientation="Horizontal">
                    <TextBox Width="180" FontSize="24" Text="{Binding RunManager.LeftBomName, UpdateSourceTrigger=PropertyChanged}">

                        <i:Interaction.Triggers>
                            <!--  加载时拿到该控件的引用，所以用的相对资源  -->
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding RunManager.LeftTextBoxLoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBox}}" />
                            </i:EventTrigger>
                            <!--  输入框每次按键抬起时触发  -->
                            <i:EventTrigger EventName="KeyUp">
                                <prism:InvokeCommandAction Command="{Binding RunManager.LeftTextBoxKeyUpCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Rectangle Width="10" />
                    <TextBox Width="180" FontSize="24" Text="{Binding RunManager.RightBomName, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding RunManager.RightTextBoxLoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBox}}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="KeyUp">
                                <prism:InvokeCommandAction Command="{Binding RunManager.RightTextBoxKeyUpCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </StackPanel>
                <Grid>
                    <Button
                        Margin="25,10"
                        Content="开始"
                        FontSize="24"
                        Command="{Binding RunCommand}" />
                    <Button
                        Margin="25,10"
                        Content="停止"
                        FontSize="24"
                        Command="{Binding StopCommand}"
                        Background="PaleVioletRed" />
                </Grid>

            </StackPanel>
            <!--  运行流程  -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl Grid.Row="1" Margin="8" ItemsSource="{Binding RunManager.TaskParameter.ProcessEntities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="auto"
                                Margin="0,0,0,10"
                                Padding="8"
                                Background="#F5F5F5"
                                BorderThickness="1"
                                BorderBrush="#DFDFDF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="5,0"
                                        VerticalAlignment="Bottom"
                                        TextWrapping="Wrap"
                                        FontSize="18">
                                        <Run Text="{Binding Content}" />
                                        <Run Text="{Binding Seconds}" />
                                        <Run Text="s" />
                                    </TextBlock>
                                    <mah:MetroProgressBar
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Height="1"
                                        Margin="5"
                                        Foreground="Green"
                                        Style="{StaticResource MahApps.Styles.MetroProgressBar}"
                                        Value="{Binding Percent}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="5"
                                        VerticalAlignment="Center"
                                        FontSize="12">
                                        <Run Text="{Binding Percent, StringFormat={}{0:F2}}" />
                                        <Run Text="%" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!--  模板定义  -->
            <Border
                Grid.Row="1"
                Background="White"
                CornerRadius="5"
                BorderThickness="0,0,1,1"
                BorderBrush="#F5F5F5"
                Visibility="{Binding RunManager.TaskParameter.ShowTempateRegion}">
                <StackPanel>
                    <TextBlock
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="请制作丝印模板" />
                    <Image Height="350" Margin="10" Source="{Binding RunManager.TaskParameter.TempateGDI.ImageSource}" />
                    <Button
                        Margin="10"
                        Content="确定"
                        Command="{Binding RunManager.OKTempateCommand}"
                        FontSize="16" />
                    <Button
                        Margin="10"
                        Content="取消"
                        Command="{Binding RunManager.CancelTempateCommand}"
                        FontSize="16" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Background="#F5F5F5">
                <!--<TextBlock
                    Margin="15,8"
                    VerticalAlignment="Center"
                    Text="@重庆教主 ©copyright 2025"
                    FontSize="14"
                    Foreground="Gray" />-->
            </StackPanel>
        </Grid>
        <!--  right  -->
        <Grid Grid.Column="1">
            <!--  测量结果  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="500"
                Text="{Binding RunManager.Message}"
                FontSize="200" />
            <Border
                Width="auto"
                Height="55"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="500"
                CornerRadius="5">
                <Border.Background>
                    <!--  50%半透明背景  -->
                    <SolidColorBrush Color="#80FFFFFF" />
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <WrapPanel>
                        <RadioButton
                            Style="{StaticResource RadioButton.Preview.Style}"
                            IsChecked="True"
                            Command="{Binding SelectCameraCommand}"
                            CommandParameter="{x:Static cameraEnums:CameraType.left}">
                            <RadioButton.Content>
                                <iconPacks:PackIconMaterial Width="45" Height="45" Kind="Cctv">
                                    <iconPacks:PackIconMaterial.RenderTransform>
                                        <ScaleTransform ScaleX="-1" ScaleY="1" />
                                    </iconPacks:PackIconMaterial.RenderTransform>
                                    <iconPacks:PackIconMaterial.RenderTransformOrigin>
                                        <Point X="0.5" Y="0.5" />
                                    </iconPacks:PackIconMaterial.RenderTransformOrigin>
                                </iconPacks:PackIconMaterial>
                            </RadioButton.Content>
                        </RadioButton>
                        <Rectangle Width="10" />
                        <RadioButton Style="{StaticResource RadioButton.Preview.Style}" Command="{Binding SelectCameraCommand}" CommandParameter="{x:Static cameraEnums:CameraType.right}">
                            <RadioButton.Content>
                                <iconPacks:PackIconMaterial Width="45" Height="45" Kind="Cctv" />
                            </RadioButton.Content>
                        </RadioButton>
                    </WrapPanel>
                    <Rectangle Width="10" />
                    <Border Width="2" Margin="5" Background="Black" />
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}">
                        <RadioButton.Content>
                            <iconPacks:PackIconMaterial Width="45" Height="45" Kind="CameraPlus" />
                        </RadioButton.Content>
                    </RadioButton>
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}">
                        <RadioButton.Content>
                            <iconPacks:PackIconMaterial Width="45" Height="45" Kind="CameraControl" />
                        </RadioButton.Content>
                    </RadioButton>
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}">
                        <RadioButton.Content>
                            <iconPacks:PackIconMaterial Width="45" Height="45" Kind="VectorCircle" />
                        </RadioButton.Content>
                    </RadioButton>
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}" Command="{Binding CanSelectRectCommand}">
                        <RadioButton.Content>
                            <iconPacks:PackIconMaterial Width="45" Height="45" Kind="VectorRectangle" />
                        </RadioButton.Content>
                    </RadioButton>
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}" Command="{Binding SaveImageCommand}">
                        <RadioButton.Content>
                            <iconPacks:PackIconBoxIcons Width="45" Height="45" Kind="SolidSave" />
                        </RadioButton.Content>
                    </RadioButton>
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}">
                        <RadioButton.Content>
                            <iconPacks:PackIconPicolIcons Width="45" Height="45" Kind="DocumentImage" />
                        </RadioButton.Content>
                    </RadioButton>
                    <Rectangle Width="10" />
                    <RadioButton Style="{StaticResource RadioButton.Preview.Style}">
                        <RadioButton.Content>
                            <iconPacks:PackIconPicolIcons Width="45" Height="45" Kind="DocumentImageEdit" />
                        </RadioButton.Content>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Border.Cell.Color}" />
            <contorls:CameraBox ImageSource="{Binding PhotoManager.Currentphoto.ImageSource}" IsMouseSelect="{Binding CanSelect}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="RectChanged">
                        <prism:InvokeCommandAction Command="{Binding RunManager.RectChangedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </contorls:CameraBox>
        </Grid>
    </Grid>
</UserControl>
