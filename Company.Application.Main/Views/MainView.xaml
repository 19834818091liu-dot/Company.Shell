<UserControl
    x:Class="Company.Application.Main.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Company.Application.Main.Views"
    xmlns:vm="clr-namespace:Company.Application.Main.ViewModels"
    xmlns:core="clr-namespace:Company.Core.Models;assembly=Company.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="900"
    d:DesignWidth="1500"
    FontSize="16"
    Background="{StaticResource Company.Main.Background.Color}"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Background="#3B4446">
                <RadioButton
                    Content="开始"
                    Style="{StaticResource RadioButton.Menu.Style}"
                    IsChecked="True"
                    Command="{Binding NavigationgToViewCommand}"
                    CommandParameter="{x:Static core:Names.RunView}">
                    <RadioButton.Tag>
                        <iconPacks:PackIconBoxIcons Width="20" Height="20" Kind="RegularHome" />
                    </RadioButton.Tag>
                </RadioButton>
                <RadioButton
                    Content="设置"
                    Style="{StaticResource RadioButton.Menu.Style}"
                    Command="{Binding NavigationgToViewCommand}"
                    CommandParameter="{x:Static core:Names.ConfigView}">
                    <RadioButton.Tag>
                        <iconPacks:PackIconFeatherIcons Width="20" Height="20" Kind="Settings" />
                    </RadioButton.Tag>
                </RadioButton>
                <RadioButton
                    Content="相机标定"
                    Style="{StaticResource RadioButton.Menu.Style}"
                    Command="{Binding NavigationgToViewCommand}"
                    CommandParameter="{x:Static core:Names.CameraCalibrationView}" />
                <RadioButton
                    Content="MARK校准"
                    Style="{StaticResource RadioButton.Menu.Style}"
                    Command="{Binding NavigationgToViewCommand}"
                    CommandParameter="{x:Static core:Names.ConfigMarkView}" />
                <RadioButton
                    Content="轴标定"
                    Style="{StaticResource RadioButton.Menu.Style}"
                    Command="{Binding NavigationgToViewCommand}"
                    CommandParameter="{x:Static core:Names.AxisCalibrationView}" />
                <RadioButton
                    Content="BOM管理"
                    Style="{StaticResource RadioButton.Menu.Style}"
                    Command="{Binding NavigationgToViewCommand}"
                    CommandParameter="{x:Static core:Names.BomView}" />
                <RadioButton Content="切换用户" Style="{StaticResource RadioButton.Menu.Style}" Command="{Binding LogoutCommand}" />
            </StackPanel>
            <!--  主要区域  -->
            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="{x:Static core:Names.MainRegion}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Loaded">
                        <i:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentControl}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ContentControl>
        </Grid>
        <Grid
            Panel.ZIndex="99999"
            Tag="遮罩层"
            Visibility="Collapsed"
            Background="Black"
            Opacity="0.5" />
    </Grid>
</UserControl>
