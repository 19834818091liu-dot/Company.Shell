<UserControl
    x:Class="Company.Application.Login.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Company.Application.Login.Views"
    xmlns:vm="clr-namespace:Company.Application.Login.ViewModels"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance vm:LoginViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="900"
    d:DesignWidth="1500"
    Background="{StaticResource Company.Login.Background.Color}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="1" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Column="1"
            Width="1"
            Margin="0,300,0,300"
            Background="AliceBlue" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                VerticalAlignment="Center"
                Text="视觉对位"
                TextWrapping="Wrap"
                FontSize="120"
                Foreground="White" />
            <TextBlock
                VerticalAlignment="Center"
                Text="运动控制系统"
                TextWrapping="Wrap"
                FontSize="80"
                Foreground="White" />
        </StackPanel>
        <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <iconPacks:PackIconModern
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Width="80"
                Height="60"
                Kind="CameraAuto"
                Foreground="White" />
            <TextBox
                Grid.Row="1"
                Width="300"
                Height="45"
                Margin="15"
                FontSize="30"
                Text="{Binding User.UserName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                Grid.Row="2"
                Width="300"
                Height="45"
                Margin="15"
                FontSize="30"
                Text="{Binding User.Password, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="125"
                Height="125"
                Margin="15"
                Content="登录"
                FontSize="30"
                Command="{Binding LoginCommand}" />
        </Grid>
    </Grid>
</UserControl>
