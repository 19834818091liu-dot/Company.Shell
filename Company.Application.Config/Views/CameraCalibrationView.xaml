<UserControl
    x:Class="Company.Application.Config.Views.CameraCalibrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:Company.Application.UI.Controls;assembly=Company.Application.UI"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Company.Application.Config.ViewModels"
    xmlns:camerabase="clr-namespace:Company.Hardware.Camera.Base;assembly=Company.Hardware.Camera.Base"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance vm:CameraCalibrationViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="1000"
    d:DesignWidth="1800"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid Margin="8" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Background="#F5F5F5">
            <TextBlock Margin="15,0" VerticalAlignment="Center" Text="相机标定" />
        </Border>
        <Border Grid.Row="1" Margin="15">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="700" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="700" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!--  left camera  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="586" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding LeftSelectRect}" />
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Kind="Camera" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="左相机"
                            FontSize="20"
                            FontWeight="Bold" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource Company.Main.Background.Color}">
                        <Border Grid.Row="1" Background="{StaticResource Border.Cell.Color}">
                            <controls:CameraBox ImageSource="{Binding LeftBitmap.ImageSource}" IsMouseSelect="True">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="RectChanged">
                                        <prism:InvokeCommandAction Command="{Binding LeftRectChangedCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </controls:CameraBox>
                        </Border>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <Button
                            Height="50"
                            Margin="0,10,0,15"
                            Content="左相机标定"
                            FontSize="18"
                            Command="{Binding CameraCalibrationCommand}"
                            CommandParameter="{Binding Source={x:Static camerabase:CameraType.left}}" />
                        <TextBlock Margin="0,8" FontSize="18" FontWeight="Bold">
                            <Run Text="标定结果：" />
                            <Run Text="{Binding LeftPixelToMillimeter}" Foreground="Green" />
                        </TextBlock>
                        <TextBlock Margin="0,8,0,8" TextWrapping="Wrap">
                            <Run Text="上位机中相机标定是一个复杂且精确的过程，需要注意多个方面以确保标定的准确性和可靠性。" />
                            <Run Text="标定板精度：标定板用于标定的制作精度一定要高，因为精度低的标定板会引入较大的误差。" />
                            <Run Text="标定板应放置在相机的视场范围内，且要完全覆盖相机的四个角。在采集图像时，标定板应被分别置于相机视野的正中、边缘以及四个角点等处，还要注意保持标定板一定的不同倾斜与旋转，以确保标定的全面性。" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <!--  right camera  -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="586" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding RightSelectRect}" />
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Kind="Camera" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="右相机"
                            FontSize="20"
                            FontWeight="Bold" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource Company.Main.Background.Color}">
                        <Border Grid.Row="1" Background="{StaticResource Border.Cell.Color}">
                            <controls:CameraBox ImageSource="{Binding RightBitmap.ImageSource}" IsMouseSelect="True">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="RectChanged">
                                        <prism:InvokeCommandAction Command="{Binding RightRectChangedCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </controls:CameraBox>
                        </Border>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <Button
                            Height="50"
                            Margin="0,10,0,15"
                            Content="右相机标定"
                            FontSize="18"
                            Command="{Binding CameraCalibrationCommand}"
                            CommandParameter="{Binding Source={x:Static camerabase:CameraType.right}}" />
                        <TextBlock Margin="0,8" FontSize="18" FontWeight="Bold">
                            <Run Text="标定结果：" />
                            <Run Text="{Binding RightPixelToMillimeter}" Foreground="Green" />
                        </TextBlock>
                        <TextBlock Margin="0,38,0,8" TextWrapping="Wrap">
                            <Run Text="相机稳定性：在标定过程中，相机调好后就不能再动了。稍微的移动都可能导致需要重新标定。" />
                            <Run Text="图像清晰度：对焦时要考虑到全场的清晰程度，达到一种全场的均衡。这可以通过先把光圈调到最大进行对焦，对焦完成后再把光圈减小来实现。" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <!--  标定流程  -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxHeight="800">
                        <ItemsControl Margin="25,0,12,0" ItemsSource="{Binding CalibrationManager.ProcessEntities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Height="auto"
                                        Margin="0,0,0,10"
                                        Padding="8"
                                        Background="#F5F5F5"
                                        BorderThickness="1"
                                        BorderBrush="#DFDFDF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="5,0"
                                                VerticalAlignment="Bottom"
                                                TextWrapping="Wrap"
                                                FontSize="18">
                                                <Run Text="{Binding Content}" />
                                                <Run Text="{Binding Seconds}" />
                                                <Run Text="s" />
                                            </TextBlock>
                                            <mah:MetroProgressBar
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Height="1"
                                                Margin="5"
                                                Foreground="Green"
                                                Style="{StaticResource MahApps.Styles.MetroProgressBar}"
                                                Value="{Binding Percent}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="5"
                                                VerticalAlignment="Center"
                                                FontSize="12">
                                                <Run Text="{Binding Percent, StringFormat={}{0:F2}}" />
                                                <Run Text="%" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button
                        Grid.Row="1"
                        Height="50"
                        Margin="25,10,25,10"
                        VerticalAlignment="Top"
                        Content="保存"
                        FontSize="18"
                        Command="{Binding SaveCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
