<UserControl
    x:Class="Company.Application.Config.Views.ConfigAxisView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Company.Application.Config.Views"
    xmlns:controlcard="clr-namespace:Company.Hardware.ControlCard.Base;assembly=Company.Hardware.ControlCard.Base"
    xmlns:vm="clr-namespace:Company.Application.Config.ViewModels"
    xmlns:core="clr-namespace:Company.Core.Models;assembly=Company.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance vm:ConfigAxisViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="1000"
    d:DesignWidth="1800"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--  X轴区域  -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="8"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Background="#F5F5F5">
                <TextBlock Margin="15,0" VerticalAlignment="Center" Text="X轴" />
            </Border>
            <Border Grid.Row="1" Margin="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource Company.Main.Background.Color}"
                        CornerRadius="45">
                        <TextBlock Margin="30">
                            <Run Text="X轴" />
                            <Run Text="{Binding ControlCard.XAxisPosition}" Foreground="Green" />
                        </TextBlock>

                    </Border>
                    <!--  XAxisParameter  -->
                    <StackPanel Grid.Row="1" Margin="20,0" HorizontalAlignment="Center">
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="贴胶位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_贴胶位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.X轴}"
                                Text="{Binding SystemConfigManager.XAxisParameter.贴胶位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_贴胶位}" />

                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="吸胶位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_吸胶位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.X轴}"
                                Text="{Binding SystemConfigManager.XAxisParameter.吸胶位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_吸胶位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="校正位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_校正位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.X轴}"
                                Text="{Binding SystemConfigManager.XAxisParameter.校正位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_校正位}" />
                        </StackPanel>
                    </StackPanel>
                    <!--  XAxis Control  -->
                    <WrapPanel Grid.Row="2" Margin="50,0">
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG+"
                            FontSize="18"
                            Command="{Binding AxisJogPlusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.X轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG-"
                            FontSize="18"
                            Command="{Binding AxisJogMinusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.X轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="复位"
                            FontSize="18"
                            Command="{Binding AxisRecoverCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.X轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="停止"
                            FontSize="18"
                            Command="{Binding AxisStopCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.X轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="重置"
                            FontSize="18"
                            Command="{Binding AxisResetCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.X轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            FontSize="18"
                            Command="{Binding AxisEnableCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.X轴}}">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="30"
                                    Background="{Binding ControlCard.IOEntity.OUT0, Converter={StaticResource BooleanToColorConverter}}" />
                                <TextBlock Text="使能" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <!--  Y轴区域  -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Margin="8"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Background="#F5F5F5">
                <TextBlock Margin="15,0" VerticalAlignment="Center" Text="Y轴" />
            </Border>
            <Border Grid.Row="1" Margin="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource Company.Main.Background.Color}"
                        CornerRadius="45">
                        <TextBlock Margin="30">
                            <Run Text="Y轴" />
                            <Run Text="{Binding ControlCard.YAxisPosition}" Foreground="Green" />
                        </TextBlock>
                    </Border>
                    <!--  YAxisParameter  -->
                    <StackPanel Grid.Row="1" Margin="20,0">
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="吸胶位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Y吸胶位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.Y轴}"
                                Text="{Binding SystemConfigManager.YAxisParameter.吸胶位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Y吸胶位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="等待位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Y等待位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.Y轴}"
                                Text="{Binding SystemConfigManager.YAxisParameter.等待位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Y等待位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="贴胶位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Y贴胶位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.Y轴}"
                                Text="{Binding SystemConfigManager.YAxisParameter.贴胶位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Y贴胶位}" />
                        </StackPanel>
                    </StackPanel>
                    <!--  YAxis Control  -->
                    <WrapPanel Grid.Row="2" Margin="50,0">
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG+"
                            FontSize="18"
                            Command="{Binding AxisJogPlusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Y轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG-"
                            FontSize="18"
                            Command="{Binding AxisJogMinusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Y轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="复位"
                            FontSize="18"
                            Command="{Binding AxisRecoverCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Y轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="停止"
                            FontSize="18"
                            Command="{Binding AxisStopCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Y轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="重置"
                            FontSize="18"
                            Command="{Binding AxisResetCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Y轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            FontSize="18"
                            Command="{Binding AxisEnableCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Y轴}}">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="30"
                                    Background="{Binding ControlCard.IOEntity.OUT1, Converter={StaticResource BooleanToColorConverter}}" />
                                <TextBlock Text="使能" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <!--  Z轴区域  -->
        <Grid
            Grid.Row="0"
            Grid.Column="2"
            Margin="8"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Background="#F5F5F5">
                <TextBlock Margin="15,0" VerticalAlignment="Center" Text="Z轴" />
            </Border>
            <Border Grid.Row="1" Margin="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource Company.Main.Background.Color}"
                        CornerRadius="45">
                        <TextBlock Margin="30">
                            <Run Text="Z轴" />
                            <Run Text="{Binding ControlCard.ZAxisPosition}" Foreground="Green" />
                        </TextBlock>
                    </Border>
                    <!--  ZAxisParameter  -->
                    <StackPanel Grid.Row="1" Margin="20,0">
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="贴折位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Z贴折位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.Z轴}"
                                Text="{Binding SystemConfigManager.ZAxisParameter.贴折位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Z贴折位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="吸胶位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Z吸胶位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.Z轴}"
                                Text="{Binding SystemConfigManager.ZAxisParameter.吸胶位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Z吸胶位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="待吸位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Z待吸位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.Z轴}"
                                Text="{Binding SystemConfigManager.ZAxisParameter.待吸位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Z待吸位}" />
                        </StackPanel>
                    </StackPanel>
                    <!--  ZAxis Control  -->
                    <WrapPanel Grid.Row="2" Margin="50,0">
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG+"
                            FontSize="18"
                            Command="{Binding AxisJogPlusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Z轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG-"
                            FontSize="18"
                            Command="{Binding AxisJogMinusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Z轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="复位"
                            FontSize="18"
                            Command="{Binding AxisRecoverCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Z轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="停止"
                            FontSize="18"
                            Command="{Binding AxisStopCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Z轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="重置"
                            FontSize="18"
                            Command="{Binding AxisResetCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Z轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            FontSize="18"
                            Command="{Binding AxisEnableCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.Z轴}}">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="30"
                                    Background="{Binding ControlCard.IOEntity.OUT2, Converter={StaticResource BooleanToColorConverter}}" />
                                <TextBlock Text="使能" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <!--  主轴区域  -->
        <Grid
            Grid.Row="0"
            Grid.Column="3"
            Margin="8"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Background="#F5F5F5">
                <TextBlock Margin="15,0" VerticalAlignment="Center" Text="主轴" />
            </Border>
            <Border Grid.Row="1" Margin="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource Company.Main.Background.Color}"
                        CornerRadius="45">
                        <TextBlock Margin="30">
                            <Run Text="主轴" />
                            <Run Text="{Binding ControlCard.MainAxisPosition}" Foreground="Green" />
                        </TextBlock>
                    </Border>
                    <!--  ZAxisParameter  -->
                    <StackPanel Grid.Row="1" Margin="20,0">
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="压带位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Main压带位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.主轴}"
                                Text="{Binding SystemConfigManager.MainAxisParameter.压带位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Main压带位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="切刀位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Main切刀位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.主轴}"
                                Text="{Binding SystemConfigManager.MainAxisParameter.切刀位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Main切刀位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="取带位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_Main取带位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.主轴}"
                                Text="{Binding SystemConfigManager.MainAxisParameter.取带位, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_Main取带位}" />
                        </StackPanel>
                    </StackPanel>
                    <!--  ZAxis Control  -->
                    <WrapPanel Grid.Row="2" Margin="50,0">
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG+"
                            FontSize="18"
                            Command="{Binding AxisJogPlusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.主轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG-"
                            FontSize="18"
                            Command="{Binding AxisJogMinusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.主轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="复位"
                            FontSize="18"
                            Command="{Binding AxisRecoverCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.主轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="停止"
                            FontSize="18"
                            Command="{Binding AxisStopCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.主轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="重置"
                            FontSize="18"
                            Command="{Binding AxisResetCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.主轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            FontSize="18"
                            Command="{Binding AxisEnableCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.主轴}}">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="30"
                                    Background="Red" />
                                <TextBlock Text="使能" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>



        <!--  左轴区域  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="8"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Background="#F5F5F5">
                <TextBlock Margin="15,0" VerticalAlignment="Center" Text="左棘轮轴" />
            </Border>
            <Border Grid.Row="1" Margin="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource Company.Main.Background.Color}"
                        CornerRadius="45">
                        <TextBlock Margin="30">
                            <Run Text="左棘轮轴" />
                            <Run Text="{Binding ControlCard.LeftAxisPosition}" Foreground="Green" />
                        </TextBlock>
                    </Border>
                    <!--  RightAxisParameter  -->
                    <StackPanel Grid.Row="1" Margin="20,0">
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="左剪切位" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_左剪切位"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.左棘轮轴}"
                                Text="{Binding SystemConfigManager.CalibrationParameter.LeftCutmm, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_左剪切位}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="左剪切位偏移量" />
                            <Rectangle Width="20" />
                            <TextBox
                                x:Name="_左剪切位偏移量"
                                Width="150"
                                Height="30"
                                Margin="5,0"
                                Tag="{x:Static controlcard:AxisType.左棘轮轴}"
                                Text="{Binding SystemConfigManager.CalibrationParameter.LeftCutOffsetmm, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="绝对移动" Command="{Binding MoveAbsoluteCommand}" CommandParameter="{Binding ElementName=_左剪切位偏移量}" />
                        </StackPanel>

                    </StackPanel>
                    <!--  RightAxis Control  -->
                    <WrapPanel Grid.Row="2" Margin="50,0">
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG+"
                            FontSize="18"
                            Command="{Binding AxisJogPlusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.左棘轮轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="JOG-"
                            FontSize="18"
                            Command="{Binding AxisJogMinusCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.左棘轮轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="复位"
                            FontSize="18"
                            Command="{Binding AxisRecoverCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.左棘轮轴}}" />
                        <Button
                            Width="100"
                            Height="50"
                            Margin="15,15,0,0"
                            Content="停止"
                            FontSize="18"
                            Command="{Binding AxisStopCommand}"
                            CommandParameter="{Binding Source={x:Static controlcard:AxisType.左棘轮轴}}" />
