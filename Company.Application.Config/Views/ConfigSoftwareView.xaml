<UserControl
    x:Class="Company.Application.Config.Views.ConfigSoftwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Company.Application.Config.Views"
    xmlns:vm="clr-namespace:Company.Application.Config.ViewModels"
    xmlns:core="clr-namespace:Company.Core.Models;assembly=Company.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance vm:ConfigSoftwareViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="1000"
    d:DesignWidth="1800"
    Background="Transparent"
    FontSize="16"
    mc:Ignorable="d">
    <Grid Margin="8" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Background="#F5F5F5">
            <TextBlock Margin="15,0" VerticalAlignment="Center" Text="系统设置" />
        </Border>
        <Border Grid.Row="1" Margin="15">
            <StackPanel>
                <StackPanel Margin="30,10,15,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="控制卡IP" />
                    <TextBox
                        Width="200"
                        Height="25"
                        Margin="0,0,10,0"
                        Text="{Binding SystemConfigManager.ControlCardConfig.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Width="100"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="端口号" />
                    <TextBox
                        Width="200"
                        Height="25"
                        Margin="0,0,10,0"
                        Text="{Binding SystemConfigManager.ControlCardConfig.Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="30,10,15,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="左相机" />
                    <TextBox
                        Width="200"
                        Height="25"
                        Margin="0,0,10,0"
                        Text="{Binding SystemConfigManager.leftCameraConfig.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Width="100"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="右相机" />
                    <TextBox
                        Width="200"
                        Height="25"
                        Margin="0,0,10,0"
                        Text="{Binding SystemConfigManager.rightCameraConfig.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="30,10,15,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="寸动步长mm" />
                    <TextBox
                        Width="200"
                        Height="25"
                        Margin="0,0,10,0"
                        Text="{Binding SystemConfigManager.SoftwareConfig.AxisMoveStepMM, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock
                        Width="100"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="系统标题" />
                    <TextBox
                        Width="200"
                        Height="25"
                        Margin="0,0,10,0"
                        Text="{Binding SystemConfigManager.SoftwareConfig.Title, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
