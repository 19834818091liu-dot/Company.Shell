<UserControl
    x:Class="Company.Application.Config.Views.ConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Company.Application.Config.Views"
    xmlns:vm="clr-namespace:Company.Application.Config.ViewModels"
    xmlns:core="clr-namespace:Company.Core.Models;assembly=Company.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance vm:ConfigViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="1000"
    d:DesignWidth="1800"
    Background="Transparent"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Background="White">
            <RadioButton
                Content="运动轴设置"
                Command="{Binding NavigatonToViewCommand}"
                CommandParameter="{x:Static core:Names.ConfigAxisView}"
                Style="{StaticResource RadioButton.Menu.Config.Style}">
                <RadioButton.Tag>
                    <iconPacks:PackIconMaterialDesign Width="20" Height="20" Kind="KeyboardArrowRight" />
                </RadioButton.Tag>
            </RadioButton>
            <RadioButton
                Content="IO参数"
                Command="{Binding NavigatonToViewCommand}"
                CommandParameter="{x:Static core:Names.ConfigIOView}"
                Style="{StaticResource RadioButton.Menu.Config.Style}">
                <RadioButton.Tag>
                    <iconPacks:PackIconMaterialDesign Width="20" Height="20" Kind="KeyboardArrowRight" />
                </RadioButton.Tag>
            </RadioButton>
            <RadioButton
                Content="用户设置"
                Visibility="{Binding Session.CurrentUser.Role, Converter={StaticResource RoleToVisibilityConverter}}"
                Command="{Binding NavigatonToViewCommand}"
                CommandParameter="{x:Static core:Names.ConfigUserView}"
                Style="{StaticResource RadioButton.Menu.Config.Style}">
                <RadioButton.Tag>
                    <iconPacks:PackIconMaterialDesign Width="20" Height="20" Kind="KeyboardArrowRight" />
                </RadioButton.Tag>
            </RadioButton>
            <RadioButton
                Content="系统设置"
                Command="{Binding NavigatonToViewCommand}"
                CommandParameter="{x:Static core:Names.ConfigSoftwareView}"
                Style="{StaticResource RadioButton.Menu.Config.Style}">
                <RadioButton.Tag>
                    <iconPacks:PackIconMaterialDesign Width="20" Height="20" Kind="KeyboardArrowRight" />
                </RadioButton.Tag>
            </RadioButton>
            <RadioButton Content="保存" Command="{Binding SaveConfigCommand}" Style="{StaticResource RadioButton.Menu.Config.Style}">
                <RadioButton.Tag>
                    <iconPacks:PackIconMaterialDesign Width="20" Height="20" Kind="KeyboardArrowRight" />
                </RadioButton.Tag>
            </RadioButton>
        </StackPanel>
        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="{x:Static core:Names.ConfigRegion}" />
    </Grid>
</UserControl>
